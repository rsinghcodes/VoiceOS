# App Configuration
APP_NAME=VoiceOS
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# LLM Providers
GEMINI_API_KEY=
OPENAI_API_KEY=

# LiveKit Voice Stack
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech Services (STT / TTS)
STT_PROVIDER=sarvam  # Options: sarvam, deepgram
TTS_PROVIDER=sarvam  # Options: sarvam, cartesia
SARVAM_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# Database & Cache (Provide your remote/managed URLs here)
# Example for Neon/Supabase/RDS: postgresql+asyncpg://user:pass@ep-xyz.aws.neon.tech/voiceos?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voiceos

# Example for Upstash/ElastiCache/Redis Cloud: rediss://default:pass@xyz.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# Vector Database (Qdrant Cloud or Managed Instance)
# Example for Qdrant Cloud: https://xyz-example.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
