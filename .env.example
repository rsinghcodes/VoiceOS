# ==============================================================================
# VoiceOS — Environment Configuration Template (.env)
# ==============================================================================
# Copy this file to '.env' (in the backend folder, or root if deploying via Docker)
# and fill in your actual API keys and connection URLs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
APP_NAME=VoiceOS
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 2. LLM PROVIDERS (Reasoning, Intent & Conversation)
# ------------------------------------------------------------------------------
# Required for LangGraph agent reasoning and conversation generation.
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: If you wish to benchmark or switch to OpenAI models later
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 3. LIVEKIT REAL-TIME WEBRTC STACK (Voice Transport & Session Rooms)
# ------------------------------------------------------------------------------
# Required for handling real-time audio rooms, WebRTC streaming, and participant connections.
# Free Build Tier available at: https://cloud.livekit.io/ (10,000 minutes/month free)
LIVEKIT_URL=wss://your-project-subdomain.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# ------------------------------------------------------------------------------
# 4. SPEECH SERVICES: STT & TTS (Sarvam AI / Deepgram / Cartesia)
# ------------------------------------------------------------------------------
# Default provider strategy: "sarvam" (optimized for Indian English, Hindi & regional languages)
# Alternative options: STT_PROVIDER=deepgram, TTS_PROVIDER=cartesia
STT_PROVIDER=sarvam
TTS_PROVIDER=sarvam

# Sarvam AI API Key (Get free signup credits at: https://sarvam.ai)
# Powers Speech-to-Text (Saaras) and Text-to-Speech (Bulbul)
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional: Only needed if you switch STT_PROVIDER to "deepgram"
DEEPGRAM_API_KEY=

# Optional: Only needed if you switch TTS_PROVIDER to "cartesia" or "elevenlabs"
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# ------------------------------------------------------------------------------
# 5. POSTGRESQL (Authoritative ACID Database for Orders, Menu, Tenancy)
# ------------------------------------------------------------------------------
# Authoritative source of truth for Products, Categories, Orders, and Customers.
# Supports any remote/managed PostgreSQL (Neon, Supabase, AWS RDS, Aiven, etc.)
# NOTE: Must use the 'postgresql+asyncpg://' driver scheme for async execution.
#
# Examples:
#   Local:    postgresql+asyncpg://postgres:postgres@localhost:5432/voiceos
#   Neon/RDS: postgresql+asyncpg://user:password@ep-cool-project.aws.neon.tech/voiceos?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voiceos

# ------------------------------------------------------------------------------
# 6. REDIS (Fast Session Caching, TTL States & Distributed Locks)
# ------------------------------------------------------------------------------
# Used for temporary conversation caches and fast key-value lookups.
# (If Redis is temporarily unreachable, the app automatically falls back to in-memory cache)
# Supports Upstash, Redis Cloud, AWS ElastiCache, or self-hosted Redis.
#
# Examples:
#   Local:   redis://localhost:6379/0
#   Upstash: rediss://default:your_password@your-endpoint.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 7. QDRANT (Vector Search Engine for Multi-Tenant Knowledge / RAG)
# ------------------------------------------------------------------------------
# Used for storing and retrieving business FAQs, policies, and unstructured knowledge.
# Supports Qdrant Cloud (Free cluster available at: https://cloud.qdrant.io/) or self-hosted.
#
# Examples:
#   Local:        http://localhost:6333
#   Qdrant Cloud: https://xyz-cluster-id.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
